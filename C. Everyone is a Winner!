#include <iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main() {
   int n;
    cin>>n;
    while(n--){
      int x;
        cin>>x;
        vector<int>v;

        v.push_back(0);
        
        int e=x;
        int f=1;
        
        while(f<=e){
        
            if(e==f)v.push_back(e);
            else{
                v.push_back(e);
                v.push_back(f);
            }
            f++;
            e=x/f;
        }

        sort(v.begin(),v.end());
        int k=v.size();
        cout<<k<<endl;
        for(int i=0;i<k;i++)cout<<v[i]<<' ';
        cout<<endl;
    }
    
}
